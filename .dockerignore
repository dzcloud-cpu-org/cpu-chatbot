# Docker 이미지에 포함하지 않을 목록

# 가상환경 / 캐시
.venv/
venv/
__pycache__/
*.py[cod]

# 환경변수 / 비밀값
.env

# 개발 도구 / 버전관리
.vscode/
.git/
.gitignore
*.log

# 문서 / 개발용 스크립트 (런타임에 불필요)
README.md
.env.example

# lambda/는 별도 zip으로 독립 배포되는 코드라 backend 이미지에 필요 없다
lambda/

# 테스트 / 문서 / IaC (런타임에 불필요, 이미지 크기만 늘림)
tests/
docs/
requirements-dev.txt
template.yaml
k8s/
